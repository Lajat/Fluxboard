{
  "name": "fluxboard",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time collaborative Kanban board — Next.js + Node/Express + MongoDB + Socket.io",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @fluxboard/api dev",
    "dev:web": "pnpm --filter @fluxboard/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.1.0"
  },
  "packageManager": "pnpm@9.0.0+sha512.b4106707c7225b1748b61595953ccbebff97b54ad05d002aa3635f633b9c53cd666f7ce9b8bc44704f1fa048b9a49b55371ab2d9e9d667d1efe2ef1514bcd513",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
