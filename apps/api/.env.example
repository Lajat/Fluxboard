PORT=4000
MONGODB_URI=mongodb://localhost:27017/fluxboard
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
WEB_ORIGIN=http://localhost:3000
# Set by the hosting platform in production (e.g. Vercel/Render auto-set this) — affects whether auth cookies require HTTPS (secure flag). Defaults to non-production locally, which is what you want for http://localhost.
NODE_ENV=development
